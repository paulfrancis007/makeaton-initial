# Backend Environment Variables
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_USER=brightloop_app
POSTGRES_PASSWORD=brightloop_dev_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brightloop_dev
DATABASE_URL=postgresql+psycopg://brightloop_app:brightloop_dev_password@localhost:5432/brightloop_dev

# Brevo / SMTP Email Delivery Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login-here
SMTP_PASSWORD=your-smtp-key-here
SMTP_TLS=true
EMAILS_FROM_NAME=Brightloop Billing
EMAILS_FROM_EMAIL=billing@yourdomain.com
