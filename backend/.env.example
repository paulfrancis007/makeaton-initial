# Copy to .env and set private local credentials. URL-encode password characters.
DATABASE_URL=postgresql+psycopg://brightloop_app:CHANGE_ME@127.0.0.1:5432/brightloop_dev
TEST_DATABASE_URL=postgresql+psycopg://brightloop_test:CHANGE_ME@127.0.0.1:5432/brightloop_test
FRONTEND_ORIGIN=http://localhost:3000

# Application environment
APP_ENV=development
APP_NAME=Brightloop
TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
SESSION_SECRET_KEY=change-this-in-production-to-a-random-secret-key-32-chars

# Company details for invoice snapshots and headers
COMPANY_NAME=Brightloop Technologies Private Limited
COMPANY_TAX_ID=GSTIN29ABCDE1234F1Z5
COMPANY_EMAIL=billing@brightloop.test
COMPANY_PHONE=+91 80 1234 5678
COMPANY_ADDRESS_LINE1=100 Innovation Boulevard
COMPANY_ADDRESS_LINE2=Suite 400
COMPANY_CITY=Bengaluru
COMPANY_STATE=Karnataka
COMPANY_POSTAL_CODE=560100
COMPANY_COUNTRY=India

# Local Docker Mailpit; no authentication or TLS for loopback-only development.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
EMAIL_FROM=Brightloop <noreply@brightloop.test>
