# Root environment template for Brightloop development
# Copy to .env or use individual backend/.env and frontend/.env

# Database Configuration (Docker Compose & PostgreSQL)
POSTGRES_USER=brightloop_app
POSTGRES_PASSWORD=brightloop_dev_password
POSTGRES_DB=brightloop_dev
POSTGRES_PORT=5432
POSTGRES_SERVER=localhost
DATABASE_URL=postgresql+psycopg://brightloop_app:brightloop_dev_password@localhost:5432/brightloop_dev

# Backend Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000"]

# Brevo / SMTP Email Delivery Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login-here
SMTP_PASSWORD=your-smtp-key-here
SMTP_TLS=true
EMAILS_FROM_NAME=Brightloop Billing
EMAILS_FROM_EMAIL=billing@yourdomain.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
